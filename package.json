{
  "name": "mda",
  "version": "1.0.0",
  "private": true,
  "description": "Media Asset Management System",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "clean": "turbo run clean && rm -rf node_modules",
    "db:migrate": "turbo run db:migrate",
    "db:seed": "turbo run db:seed"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "devDependencies": {
    "turbo": "^2.2.3",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "fast-uri": ">=3.1.5",
    "uuid": "^11.1.1"
  },
  "packageManager": "npm@10.9.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "allowScripts": {
    "bcrypt@6.0.0": true,
    "esbuild@0.28.1": true,
    "fsevents@2.3.3": true,
    "msgpackr-extract@3.0.4": true
  }
}
