flowchart TB
  %% MDA current architecture
  %% Read left to right by request path, then down into background work and storage.

  User["User Browser"]

  subgraph Docker["Docker Compose"]
    Caddy["Caddy reverse proxy<br/>ports 80 and 443"]
    App["mda-app container<br/>runs web :3000 and backend :4000"]
    Postgres[("PostgreSQL<br/>users, assets, tags, audit")]
    Redis[("Redis<br/>BullMQ queues and queue state")]
    MediaFiles[("/data/media<br/>mounted from ./media-files")]
    CacheFiles[("/app/apps/backend/cache<br/>thumbnails, previews, HLS, transcodes")]
  end

  subgraph Web["apps/web - Remix + Vite"]
    Dashboard["Dashboard route<br/>browse, upload, move, copy, delete"]
    Viewer["MediaAssetViewer<br/>preview, edit text/markdown, duplicate, actions"]
    CompressUI["CompressDialog and QueuePanel<br/>image, video, PDF compression"]
    ApiClient["app/lib/api.ts<br/>GraphQL client and REST API URLs"]
  end

  subgraph Backend["apps/backend - Fastify"]
    Fastify["index.ts<br/>Fastify server"]
    GraphQL["Mercurius GraphQL<br/>schema.ts and resolvers.ts"]
    RestApi["REST endpoints<br/>upload, download, preview, video, queue"]
    Auth["JWT auth context<br/>admin/editor/viewer access"]
  end

  subgraph FileOps["File Library Operations"]
    Indexer["media-indexer<br/>indexes all regular non-hidden files"]
    Watcher["media-watcher<br/>watches /data/media changes"]
    FileTypes["file-types<br/>image, video, PDF, Word, Excel, text, markdown, other"]
    Duplicate["duplicateMediaAsset and duplicateFolder<br/>copy files or folders without overwrite"]
    MoveRenameDelete["move, rename, delete<br/>files and folders"]
    Upload["/api/upload<br/>stores arbitrary files safely"]
  end

  subgraph Preview["Preview and Editing"]
    PreviewRoutes["/file-preview/:id<br/>PDF stream and document content JSON"]
    TextEdit["PUT /file-preview/:id/content<br/>edit .txt and .md in place"]
    DocPreview["DOCX to sanitized HTML<br/>XLSX to bounded sheet JSON"]
    PdfPreview["PDF inline iframe preview"]
  end

  subgraph Background["Background Jobs"]
    Queues["queue.ts<br/>BullMQ queues"]
    ThumbnailWorker["thumbnail worker<br/>images, videos, PDFs, docs, text, markdown, Excel"]
    MediaRefreshWorker["media-refresh worker<br/>full library re-index"]
    EncodingWorker["encoding worker<br/>video HLS generation"]
    CompressionWorker["compression worker<br/>image, video, PDF previews"]
    CacheMaintenance["cache-maintenance<br/>evicts old cache files"]
  end

  subgraph MediaProcessing["Media Processing Helpers"]
    Thumbnails["thumbnail.ts<br/>Sharp, ffmpeg, Ghostscript, mammoth, xlsx"]
    VideoTranscode["video-transcode.ts<br/>MP4 compatibility and HLS"]
    Compression["compress helpers<br/>image/video/PDF output previews"]
  end

  User -->|"HTTPS or direct localhost"| Caddy
  Caddy -->|"frontend requests"| App
  Caddy -->|"backend paths"| App
  App --> Web
  App --> Backend

  Dashboard --> Viewer
  Dashboard --> CompressUI
  Dashboard --> ApiClient
  Viewer --> ApiClient
  CompressUI --> ApiClient

  ApiClient -->|"GraphQL /graphql"| GraphQL
  ApiClient -->|"REST /api, /download, /file-preview, /video"| RestApi

  Fastify --> GraphQL
  Fastify --> RestApi
  GraphQL --> Auth
  RestApi --> Auth

  GraphQL --> FileOps
  RestApi --> Upload
  RestApi --> PreviewRoutes
  RestApi --> Compression

  Upload --> MediaFiles
  Upload --> Indexer
  Watcher --> MediaFiles
  Watcher --> Indexer
  Indexer --> FileTypes
  Indexer --> Postgres
  Duplicate --> MediaFiles
  Duplicate --> Indexer
  MoveRenameDelete --> MediaFiles
  MoveRenameDelete --> Postgres

  PreviewRoutes --> PdfPreview
  PreviewRoutes --> DocPreview
  PreviewRoutes --> TextEdit
  PreviewRoutes --> MediaFiles
  TextEdit --> MediaFiles
  TextEdit --> Postgres
  DocPreview --> MediaFiles
  PdfPreview --> MediaFiles

  GraphQL --> Queues
  RestApi --> Queues
  Queues --> Redis
  Queues --> ThumbnailWorker
  Queues --> MediaRefreshWorker
  Queues --> EncodingWorker
  Queues --> CompressionWorker

  ThumbnailWorker --> Thumbnails
  MediaRefreshWorker --> Indexer
  EncodingWorker --> VideoTranscode
  CompressionWorker --> Compression

  Thumbnails --> MediaFiles
  Thumbnails --> CacheFiles
  Thumbnails --> Postgres
  VideoTranscode --> MediaFiles
  VideoTranscode --> CacheFiles
  Compression --> MediaFiles
  Compression --> CacheFiles
  CacheMaintenance --> CacheFiles
  CacheMaintenance --> Postgres

  Postgres -. "asset rows include file_path, mime_type, thumbnail_path" .-> Dashboard
  CacheFiles -. "/thumbnails, /compress-preview, /hls, /transcoded" .-> Viewer

  classDef user fill:#f8fafc,stroke:#64748b,color:#0f172a
  classDef app fill:#e0f2fe,stroke:#0284c7,color:#0f172a
  classDef backend fill:#ecfdf5,stroke:#059669,color:#052e16
  classDef worker fill:#fef3c7,stroke:#d97706,color:#451a03
  classDef store fill:#f3e8ff,stroke:#7e22ce,color:#2e1065
  classDef file fill:#fff1f2,stroke:#e11d48,color:#4c0519

  class User user
  class Dashboard,Viewer,CompressUI,ApiClient app
  class Fastify,GraphQL,RestApi,Auth,PreviewRoutes,TextEdit,DocPreview,PdfPreview backend
  class Queues,ThumbnailWorker,MediaRefreshWorker,EncodingWorker,CompressionWorker,CacheMaintenance,Thumbnails,VideoTranscode,Compression worker
  class Postgres,Redis,MediaFiles,CacheFiles store
  class Indexer,Watcher,FileTypes,Duplicate,MoveRenameDelete,Upload file
