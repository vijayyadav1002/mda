# Root .env — read by docker compose on the HOST and interpolated into
# docker-compose.yml. These values are NOT passed into containers; per-service
# container config lives in .env.docker.
#
# Copy to .env and edit:  cp .env.example .env

# Hostname Caddy serves on (HTTPS cert + PWA install URL).
MDA_HOSTNAME=localhost

# Optional: root of an external disk, referenced by MEDIA_LIBRARY_HOST_PATH below.
EXTERNAL_VOLUME_PATH=/mnt/external

# Host directory mounted at /data/media in the app container.
# Defaults to ./media-files when unset or empty.
# MEDIA_LIBRARY_HOST_PATH=${EXTERNAL_VOLUME_PATH}/media-files
